// ---------------------------------------------------------------------------
// Prisma schema for the Vadász Gyula fan site.
// Database: PostgreSQL.
// Run: `npm run prisma:generate` then `npm run prisma:migrate`.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single TikTok video (or curated highlight) shown on the site.
model Video {
  id          String   @id @default(cuid())
  /// Original TikTok video id (numeric string from the URL).
  tiktokId    String   @unique
  caption     String
  /// Slugified, searchable title derived from the caption.
  slug        String   @unique
  thumbnailUrl String
  videoUrl    String
  embedUrl    String?
  durationSec Int      @default(0)
  uploadedAt  DateTime
  /// Free-text keywords for the search feature.
  keywords    String[]
  featured    Boolean  @default(false)
  funny       Boolean  @default(false)

  categories CategoryOnVideo[]
  stats      Statistic?
  featuredIn FeaturedClip?
  votes      CommunityVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedAt])
  @@index([funny])
  @@index([featured])
}

/// Content categories (e.g. "Rage", "Fesztivál", "Kutyák").
model Category {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  emoji     String?
  videos    CategoryOnVideo[]
  createdAt DateTime          @default(now())
}

/// Many-to-many join between videos and categories.
model CategoryOnVideo {
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId    String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  assignedAt DateTime @default(now())

  @@id([videoId, categoryId])
}

/// Engagement metrics for a video. Kept in a separate table so it can be
/// refreshed independently of the (mostly immutable) video metadata.
model Statistic {
  id        String   @id @default(cuid())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId   String   @unique
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  /// Computed "funny score" used for the Funniest Clips ranking.
  funnyScore Float   @default(0)
  fetchedAt DateTime @default(now())
}

/// Editorially featured clips with an explicit display order.
model FeaturedClip {
  id        String   @id @default(cuid())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId   String   @unique
  position  Int      @default(0)
  reason    String?
  createdAt DateTime @default(now())

  @@index([position])
}

/// Community "favourite clip" votes. A simple anonymous voting model keyed
/// by a client-side fingerprint to limit duplicate votes.
model CommunityVote {
  id          String   @id @default(cuid())
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId     String
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([videoId, fingerprint])
  @@index([videoId])
}

/// Community-submitted content awaiting moderation (admin panel).
model Submission {
  id        String           @id @default(cuid())
  tiktokUrl String
  note      String?
  authorName String?
  status    SubmissionStatus @default(PENDING)
  createdAt DateTime         @default(now())
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
