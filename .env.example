# ─────────────────────────────────────────────────────────────
# Spotify OAuth — required to connect a real account.
# Create an app at https://developer.spotify.com/dashboard
# and add the redirect URI below to the app's settings.
# ─────────────────────────────────────────────────────────────

SPOTIFY_CLIENT_ID=your_client_id_here

# Optional. The app uses Authorization Code + PKCE, which does not require a
# secret. Set this only if your Spotify app is configured as "confidential" —
# when present it is sent along with the PKCE verifier on token exchange.
SPOTIFY_CLIENT_SECRET=

# Must match a Redirect URI registered on the Spotify app, exactly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Public origin of the app. Used to build absolute redirect URLs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
