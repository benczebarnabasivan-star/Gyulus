# ---------------------------------------------------------------------------
# Vadász Gyula Fan Site — Environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Public site URL (used for SEO, sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# TikTok content
# The site shows REAL videos via TikTok's OFFICIAL embeds (oEmbed + creator
# widget). No API key or credentials are required.
#   - The creator's live feed is rendered by TikTok's official embed.js.
#   - Curated/featured videos are enriched via the public oEmbed endpoint.
# To curate which videos appear, edit src/lib/data/realVideos.ts.
# ---------------------------------------------------------------------------
# TikTok handle of the creator (without the @)
TIKTOK_USERNAME="vadasz_gyula"
# How long (seconds) to cache oEmbed responses (default 1 hour)
TIKTOK_CACHE_TTL="3600"

# ---------------------------------------------------------------------------
# PostgreSQL (OPTIONAL) — only needed for the persistent community/admin
# features. The site runs without it (submissions use an in-memory store).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://gyulus:gyulus@localhost:5432/gyulus?schema=public"

# Admin panel shared secret (community submission moderation)
ADMIN_PASSWORD="change-me"
