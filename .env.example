# ---------------------------------------------------------------------------
# Vadász Gyula Fan Site — Environment variables
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------------------

# Public site URL (used for SEO, sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://gyulus:gyulus@localhost:5432/gyulus?schema=public"

# ---------------------------------------------------------------------------
# TikTok data source (OPTIONAL)
# The app ships with a curated seed dataset so it runs without any external
# credentials. To pull live data, configure ONE of the adapters below and set
# TIKTOK_DATA_SOURCE accordingly. See src/lib/services/tiktok.ts.
#   - "seed"     : built-in curated dataset (default, no network)
#   - "rapidapi" : third-party TikTok scraper APIs via RapidAPI
#   - "official" : TikTok Display API (requires app review + access token)
# ---------------------------------------------------------------------------
TIKTOK_DATA_SOURCE="seed"
TIKTOK_USERNAME="vadasz_gyula"

# Official TikTok Display API (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ACCESS_TOKEN=""

# RapidAPI fallback (any TikTok scraper provider, e.g. tiktok-scraper7)
RAPIDAPI_KEY=""
RAPIDAPI_HOST="tiktok-scraper7.p.rapidapi.com"

# Cache TTL for fetched TikTok data, in seconds (default 1 hour)
TIKTOK_CACHE_TTL="3600"

# ---------------------------------------------------------------------------
# Admin panel (simple shared-secret gate for the demo admin area)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD="change-me"
